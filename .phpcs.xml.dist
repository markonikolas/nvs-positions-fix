<?xml version="1.0"?>
<ruleset name="WordPress Plugin Boilerplate">
	<description>Custom ruleset for the WordPress Plugin Boilerplate.</description>

	<!-- Use WordPress-Extra as base -->
	<rule ref="WordPress-Extra" />

	<!-- Exclude specific filename rules -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- Additional configurations -->
	<arg name="extensions" value="php" />
	<arg name="colors" />
	<arg value="s" /> <!-- Show sniff codes in the report -->

	<!-- List files and directories to check -->
	<file>src</file>
	<file>plugin.php</file>
</ruleset>
